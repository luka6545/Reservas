@model List<ReservaWeb.Models.BebidaViewModel>
@{
    ViewData["Title"] = "Menú y Pedidos";
}

<div class="container mt-4">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]</div>
    }
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["Exito"]</div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">Menú de Bebidas</h4>
                </div>
                <div class="card-body">
                    <form asp-action="EnviarPedido" method="post">
                        <input type="hidden" name="reservaId" value="@ViewBag.ReservaId" />

                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Bebida</th>
                                    <th>Categoría</th>
                                    <th>Precio</th>
                                    <th width="150px">Cantidad</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Count; i++)
                                {
                                    <tr>
                                        <td><strong>@Model[i].Nombre</strong></td>
                                        <td><span class="badge bg-secondary">@(Model[i].Categoria?.NombreCategoria ?? "Bebida")</span></td>
                                        <td>Bs. @Model[i].Precio</td>
                                        <td>
                                            <input type="hidden" name="Items[@i].BebidaId" value="@Model[i].Id" />
                                            <input type="number" name="Items[@i].Cantidad" class="form-control text-center" min="0" max="@Model[i].Stock" value="0" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit" class="btn btn-success btn-lg">Enviar Pedido a Barra</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow border-warning">
                <div class="card-header bg-warning text-dark fw-bold">
                    <h5 class="mb-0">Mi Cuenta Actual</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.CuentaActual != null)
                    {
                        var cuenta = (ReservaWeb.Models.PedidoViewModel)ViewBag.CuentaActual;

                        <ul class="nav nav-pills nav-justified mb-3" id="pills-tab" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active py-1" data-bs-toggle="pill" data-bs-target="#tab-resumen" type="button">Resumen</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link py-1" data-bs-toggle="pill" data-bs-target="#tab-historial" type="button">Por Rondas</button>
                            </li>
                        </ul>

                        <div class="tab-content" id="pills-tabContent">
                            <div class="tab-pane fade show active" id="tab-resumen" role="tabpanel">
                                @{
                                    // Magia de C# LINQ para agrupar las bebidas por nombre y sumar sus cantidades
                                    var agrupados = cuenta.Detalles
                                    .GroupBy(d => d.Bebida?.Nombre)
                                    .Select(g => new
                                    {
                                        Nombre = g.Key,
                                        Cant = g.Sum(d => d.Cantidad),
                                        Sub = g.Sum(d => d.Subtotal)
                                    });
                                }
                                <ul class="list-group mb-3 shadow-sm">
                                    @foreach (var item in agrupados)
                                    {
                                        <li class="list-group-item d-flex justify-content-between lh-sm">
                                            <div><h6 class="my-0">@item.Cant x @item.Nombre</h6></div>
                                            <span class="text-muted fw-bold">Bs. @item.Sub</span>
                                        </li>
                                    }
                                </ul>
                            </div>

                            <div class="tab-pane fade" id="tab-historial" role="tabpanel">
                                <ul class="list-group mb-3 shadow-sm text-secondary" style="font-size: 0.9em;">
                                    @for (int i = 0; i < cuenta.Detalles.Count; i++)
                                    {
                                        var detalle = cuenta.Detalles[i];
                                        <li class="list-group-item d-flex justify-content-between lh-sm bg-light">
                                            <div><small>+ @detalle.Cantidad x @(detalle.Bebida?.Nombre)</small></div>
                                            <span class="text-muted">Bs. @detalle.Subtotal</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center border-top pt-3">
                            <h4 class="text-success mb-0">Total:</h4>
                            <h4 class="text-success fw-bold mb-0">Bs. @cuenta.Total</h4>
                        </div>
                        @if (cuenta.Estado == "Cobrado")
                        {
                            <div class="alert alert-success text-center mt-3 mb-0">Cuenta Pagada ✅</div>
                            <a asp-controller="Pedidos" asp-action="Factura" asp-route-reservaId="@ViewBag.ReservaId" class="btn btn-danger w-100 mt-2 fw-bold">
                                📄 Ver Factura PDF
                            </a>
                        }
                        else
                        {
                            <div class="alert alert-info text-center mt-3 mb-0 text-dark">
                                Mesa abierta. Puedes seguir pidiendo.
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center mb-0 mt-3">Aún no has pedido nada. ¡Anímate a abrir tu cuenta!</p>
                    }
                </div>
            </div>
            <div class="mt-3 text-center">
                <a asp-controller="Reservas" asp-action="Index" class="btn btn-outline-secondary w-100">Volver a mis Reservas</a>
            </div>
        </div>
    </div>
</div>
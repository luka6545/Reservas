@model ReservaWeb.Models.RegistroViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <title>Registro - Lounge</title>
</head>
<body class="bg-dark d-flex align-items-center" style="height:100vh;">
    <div class="container col-md-5 card shadow-lg p-4">
        <h2 class="text-center">Crea tu cuenta</h2>
        <form asp-action="Register" method="post">
            <div class="mb-3">
                <label>Nombre</label>
                <input asp-for="Nombre" class="form-control" required />
            </div>
            <div class="mb-3">
                <label>Email</label>
                <input asp-for="Email" class="form-control" type="email" required />
            </div>
            <div class="mb-3 row">
                <div class="col"><label>Password</label><input asp-for="Password" class="form-control" type="password" required /></div>
                <div class="col"><label>Confirmar</label><input asp-for="ConfirmarPassword" class="form-control" type="password" required /></div>
            </div>
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }
            <button class="btn btn-success w-100">Registrarse</button>
            <p class="mt-3 text-center">¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión</a></p>
        </form>
    </div>
</body>
</html>
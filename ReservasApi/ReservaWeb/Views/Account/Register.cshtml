@model ReservaWeb.Models.RegistroViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <title>Registro - Lounge VIP</title>
</head>
<body class="d-flex align-items-center justify-content-center" style="height:100vh; background-color: #f8f7fa;">

    <div class="container col-md-5 col-sm-10">
        <div class="text-center mb-4">
            <h2 class="fw-bold" style="color: #5b21b6;">Crear Cuenta</h2>
            <p class="text-muted">Únete para realizar tus reservas</p>
        </div>

        <div class="card p-4 shadow-sm border-0">
            <form asp-action="Register" method="post">
                <div class="mb-3">
                    <label class="text-muted small fw-bold mb-1">Nombre Completo</label>
                    <input asp-for="Nombre" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-bold mb-1">Correo Electrónico</label>
                    <input asp-for="Email" class="form-control" type="email" required />
                </div>

                <div class="row mb-4">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <label class="text-muted small fw-bold mb-1">Contraseña</label>
                        <input asp-for="Password" class="form-control" type="password" required />
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small fw-bold mb-1">Confirmar Contraseña</label>
                        <input asp-for="ConfirmarPassword" class="form-control" type="password" required />
                    </div>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2 border-0" style="font-size: 0.9rem;">@ViewBag.Error</div>
                }

                <button type="submit" class="btn btn-primary w-100 py-2 mt-2">Registrarse</button>

                <p class="mt-4 text-center text-muted small">
                    ¿Ya tienes cuenta? <a asp-action="Login" style="color: #7c3aed; font-weight: bold; text-decoration: none;">Inicia sesión</a>
                </p>
            </form>
        </div>
    </div>

</body>
</html>
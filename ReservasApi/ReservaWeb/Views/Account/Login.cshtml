@model ReservaWeb.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <title>Login - Lounge VIP</title>
</head>
<body class="d-flex align-items-center justify-content-center" style="height:100vh; background-color: #f8f7fa;">

    <div class="container col-md-4 col-sm-8">
        <div class="text-center mb-4">
            <h1 class="fw-bold" style="color: #5b21b6;">🥂 LOUNGE VIP</h1>
            <p class="text-muted">Acceso Seguro al Sistema</p>
        </div>

        <div class="card p-4 shadow-sm border-0">
            <h4 class="text-center mb-4" style="color: #2d3748;">Iniciar Sesión</h4>
            <form asp-action="Login" method="post">
                <div class="mb-3">
                    <label class="text-muted small fw-bold mb-1">Correo Electrónico</label>
                    <input asp-for="Email" class="form-control" type="email" required />
                </div>
                <div class="mb-4">
                    <label class="text-muted small fw-bold mb-1">Contraseña</label>
                    <input asp-for="Password" class="form-control" type="password" required />
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2 border-0" style="font-size: 0.9rem;">@ViewBag.Error</div>
                }

                <button type="submit" class="btn btn-primary w-100 py-2 mt-2">Entrar al Sistema</button>

                <p class="mt-4 text-center text-muted small">
                    ¿No tienes cuenta? <a asp-action="Register" style="color: #7c3aed; font-weight: bold; text-decoration: none;">Regístrate aquí</a>
                </p>
            </form>
        </div>
    </div>

</body>
</html>
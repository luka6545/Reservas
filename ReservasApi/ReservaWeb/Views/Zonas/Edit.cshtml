@model ReservaWeb.Models.ZonaViewModel
@{
    ViewData["Title"] = "Editar Zona";
}
<div class="container mt-4 col-md-6">
    <div class="card shadow">
        <div class="card-header bg-warning">
            <h4>Editar Zona</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label class="form-label">Nombre de la Zona</label>
                    <input asp-for="NombreZona" class="form-control" required />
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Capacidad</label>
                    <input asp-for="CapacidadMax" type="number" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Precio Mínimo de Consumo</label>
                    <input asp-for="PrecioMinimo" type="number" step="0.01" class="form-control" required min="0" />
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Actualizar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>
@model IEnumerable<ReservaWeb.Models.ZonaViewModel>
@{
    ViewData["Title"] = "Gestión de Zonas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Zonas Lounge</h2>
        <a asp-action="Create" class="btn btn-primary">+ Nueva Zona</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Capacidad</th>
                        <th>Descripción</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.NombreZona</strong></td>
                            <td>@item.CapacidadMax</td>
                            <td>Bs. @item.PrecioMinimo</td>
                            <td class="text-center d-flex justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>

                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Estás totalmente seguro de eliminar la zona: @item.NombreZona? Esta acción no se puede deshacer.');">
                                    <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@model IEnumerable<ReservaWeb.Models.BebidaViewModel>
@{
    ViewData["Title"] = "Menú de Bebidas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Menú y Stock de Bebidas</h2>
        <a asp-action="Create" class="btn btn-primary">+ Nueva Bebida</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Bebida</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Stock Actual</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Nombre</strong></td>
                            <td><span class="badge bg-info text-dark">@(item.Categoria?.NombreCategoria ?? "Sin Categoría")</span></td>
                            <td>Bs. @item.Precio</td>
                            <td>
                                @if (item.Stock <= 5)
                                {
                                    <span class="text-danger fw-bold">@item.Stock (¡Bajo!)</span>
                                }
                                else
                                {
                                    <span class="text-success">@item.Stock</span>
                                }
                            </td>
                            <td class="text-center d-flex justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Seguro que deseas eliminar la bebida: @item.Nombre?');">
                                    <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
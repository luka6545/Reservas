@model IEnumerable<ReservaWeb.Models.ReservaViewModel>
@{
    ViewData["Title"] = User.IsInRole("Admin") ? "Gestión de Reservas" : "Mis Reservas";
}

<div class="container mt-4">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger fw-bold alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>

        @if (!User.IsInRole("Admin"))
        {
            @if (ViewBag.TienePendiente == true)
            {
                <button class="btn btn-secondary" disabled title="Tienes una reserva en espera de aprobación">
                    Nueva Reserva (Bloqueado)
                </button>
            }
            else if (ViewBag.TieneAprobada == true)
            {
                <a asp-action="Create" class="btn btn-warning fw-bold text-dark"
                   onclick="return confirm('Ya tienes una mesa Aprobada. ¿Estás seguro de que deseas reservar OTRA zona adicional?');">
                    + Nueva Reserva
                </a>
            }
            else
            {
                <a asp-action="Create" class="btn btn-success">+ Nueva Reserva</a>
            }
        }
    </div>

    <table class="table table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Fecha y Hora</th>
                <th>Cliente</th>
                <th>Zona Reservada</th>
                <th>Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                    <td><strong>@(item.Usuario?.Nombre ?? "Desconocido")</strong></td>
                    <td>@(item.ZonaLounge?.NombreZona ?? "Sin Zona")</td>
                    <td>
                        <span class="badge @(item.Estado == "Aprobada" ? "bg-success" : item.Estado == "Pendiente" ? "bg-warning text-dark" : "bg-danger")">
                            @item.Estado
                        </span>
                    </td>
                    <td class="text-center">
                        <div class="d-flex gap-2 justify-content-center">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detalles</a>

                            @if (User.IsInRole("Admin") && item.Estado == "Pendiente")
                            {
                                <form asp-action="Aprobar" asp-route-id="@item.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-success">Aprobar</button>
                                </form>
                            }

                            @if (item.Estado != "Cancelada")
                            {
                                <form asp-action="Cancelar" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Cancelar reserva?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
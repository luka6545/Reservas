@model ReservaWeb.Models.ReservaViewModel
@{
    ViewData["Title"] = "Detalle de Reserva";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Reserva #@Model.Id</h4>
                    <span class="badge @(Model.Estado == "Aprobada" ? "bg-success" : Model.Estado == "Pendiente" ? "bg-warning text-dark" : "bg-danger")">
                        @Model.Estado
                    </span>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-sm-6">
                            <h6 class="text-muted">Información del Cliente</h6>
                            <p><strong>Nombre:</strong> @(Model.Usuario?.Nombre ?? "N/A")</p>
                            <p><strong>Email:</strong> @(Model.Usuario?.Email ?? "N/A")</p>
                        </div>
                        <div class="col-sm-6 border-start">
                            <h6 class="text-muted">Espacio Reservado</h6>
                            <p><strong>Zona:</strong> @(Model.ZonaLounge?.NombreZona ?? "N/A")</p>
                            <p><strong>Fecha y Hora:</strong> @Model.FechaHora.ToString("f")</p>
                        </div>
                    </div>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="card mt-4 border-info shadow-sm">
                            <div class="card-header bg-info text-white fw-bold">
                                <h5 class="mb-0">Consumo de la Mesa</h5>
                            </div>
                            <div class="card-body">
                                @if (ViewBag.CuentaActual != null)
                                {
                                    var cuenta = (ReservaWeb.Models.PedidoViewModel)ViewBag.CuentaActual;
                                    <table class="table table-sm align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Cant.</th>
                                                <th>Bebida</th>
                                                <th class="text-end">Subtotal</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                // Agrupamos la cuenta en vivo para el Admin
                                                var cuentaAdmin = (ReservaWeb.Models.PedidoViewModel)ViewBag.CuentaActual;
                                                var detallesAgrupadosAdmin = cuentaAdmin.Detalles
                                                .GroupBy(d => d.Bebida?.Nombre ?? "Bebida")
                                                .Select(g => new
                                                {
                                                    Nombre = g.Key,
                                                    Cantidad = g.Sum(d => d.Cantidad),
                                                    Subtotal = g.Sum(d => d.Subtotal)
                                                }).ToList();
                                            }

                                            @foreach (var item in detallesAgrupadosAdmin)
                                            {
                                                <tr>
                                                    <td><span class="badge bg-secondary">@item.Cantidad</span></td>
                                                    <td>@item.Nombre</td>
                                                    <td class="text-end fw-bold">Bs. @item.Subtotal</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="alert alert-light text-center mb-0 text-muted">
                                        Esta mesa aún no ha ordenado nada.
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary mt-4 d-flex justify-content-between align-items-center shadow-sm">
                            <div>
                                <h5 class="mb-0">Pedidos a la Mesa</h5>
                                <p class="mb-0 text-muted">Abre el menú para ordenar bebidas.</p>
                            </div>
                            @if (Model.Estado == "Aprobada")
                            {
                                <a asp-controller="Pedidos" asp-action="Menu" asp-route-reservaId="@Model.Id" class="btn btn-warning fw-bold text-dark">
                                    Ver Menú y Pedir
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary disabled" title="Requiere que la reserva sea aprobada">Ver Menú (Bloqueado)</button>
                            }
                        </div>
                    }
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>

                    @if (Model.Estado != "Cancelada")
                    {
                        <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Estás seguro de que deseas cancelar esta reserva?');">
                            <button type="submit" class="btn btn-danger">Cancelar Reserva</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@model ReservaWeb.Models.ReservaViewModel
@if (!string.IsNullOrEmpty(ViewBag.Error))
{
    <div class="alert alert-danger fw-bold">@ViewBag.Error</div>
}

<div class="container mt-4 col-md-6">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h4>Nueva Reserva</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <input type="hidden" asp-for="UsuarioId" />
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label class="form-label">Selecciona la Zona</label>
                    <select asp-for="ZonaLoungeId" class="form-select" asp-items="ViewBag.Zonas">
                        <option value="">-- Seleccionar Zona --</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Fecha y Hora</label>
                    <input asp-for="FechaHora" type="datetime-local" class="form-control" />
                </div>

                <div class="alert alert-info">
                    <strong>Nota:</strong> Su reserva quedará en estado "Pendiente" hasta que un administrador la apruebe.
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Volver</a>
                    <button type="submit" class="btn btn-primary">Confirmar Reserva</button>
                </div>
            </form>
        </div>
    </div>
</div>
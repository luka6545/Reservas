<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lounge VIP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ReservaWeb.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white mb-4 shadow-sm" style="border-bottom: 3px solid #7c3aed;">
            <div class="container">
                <a class="navbar-brand fw-bold" style="color: #5b21b6;" asp-area="" asp-controller="Home" asp-action="Index">
                    🥂 LOUNGE VIP
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Inicio</a></li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Zonas" asp-action="Index">Zonas</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Categorias" asp-action="Index">Categorías</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Bebidas" asp-action="Index">Bebidas</a></li>
                                <li class="nav-item ms-lg-3"><a class="nav-link fw-bold" style="color: #7c3aed;" asp-controller="Reservas" asp-action="Index">Gestión de Reservas</a></li>
                            }
                            else
                            {
                                <li class="nav-item ms-lg-3"><a class="nav-link fw-bold" style="color: #7c3aed;" asp-controller="Reservas" asp-action="Index">Mis Reservas</a></li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item me-3 d-none d-sm-block">
                                <span class="text-muted">Hola, <strong style="color: #5b21b6;">@User.Identity.Name</strong></span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger btn-sm" asp-controller="Account" asp-action="Logout">Cerrar Sesión</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2"><a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Iniciar Sesión</a></li>
                            <li class="nav-item"><a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Registrarse</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-top text-muted mt-auto py-3">
        <div class="container text-center">
            &copy; @DateTime.Now.Year - Lounge VIP System
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>